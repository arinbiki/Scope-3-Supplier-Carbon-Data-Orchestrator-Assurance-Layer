# ==============================================================================
# Scope 3 Supplier Carbon Data Orchestrator & Assurance Layer - Environment Template
# ==============================================================================

# PostgreSQL 18 State Blackboard
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/windmill
PG_SCHEMA=scope3_carbon
PG_USER=postgres
PG_PASSWORD=postgres
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=windmill

# Windmill Decision Engine
WINDMILL_BASE_URL=http://localhost:8080
WINDMILL_WORKSPACE=demo
WINDMILL_TOKEN=your_windmill_token_here
WINDMILL_SCRIPT_PATH=f/carbon_data/non_violent_script

# Self-Hosted n8n Instance
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your_n8n_api_key_here
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret_here

# Evidence Storage & Cloud Vault
EVIDENCE_S3_BUCKET=carbon-assurance-vault
EVIDENCE_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Regulatory & Factor Library Integrations
DEFRA_API_KEY=your_defra_api_key_here
ECOINVENT_SUBSCRIPTION_KEY=your_ecoinvent_license_key
CDP_SUPPLY_CHAIN_TOKEN=your_cdp_token_here
